# ============================================================================
# ComputeSwarm — Environment Variable Template (.env.example)
# ============================================================================
# Copy this file to .env and adjust values for your environment.
#   cp .env.example .env
#
# NO REAL SECRETS should be committed to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# App Environment
# ----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development

# Secret key used for JWT signing, session tokens, and other crypto.
# ⚠️  CHANGE THIS IN PRODUCTION. Use a long, random string.
SECRET_KEY=change-me-in-production

# JWT access token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Used by the backend FastAPI app and Alembic migrations.
# When running inside Docker, use the service name (db) as host.
# When running natively on the host, use localhost.
DATABASE_URL=postgresql://computeswarm:changeme@db:5432/computeswarm

# ----------------------------------------------------------------------------
# Redis (Cache, Queue, Pub/Sub)
# ----------------------------------------------------------------------------
# Redis URL for Celery task queues, WebSocket state, and caching.
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# MinIO (S3-compatible Object Storage)
# ----------------------------------------------------------------------------
# Endpoint for the MinIO server.
# Use 'minio:9000' inside Docker; use 'localhost:9000' when running natively.
MINIO_ENDPOINT=minio:9000

# MinIO v4.0+ credentials (server-side). These must match the values set in
# docker-compose.yml for the minio service.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Legacy boto3 credentials (kept for backward compatibility).
# These should match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Default bucket name for job inputs, outputs, and logs.
MINIO_BUCKET=computeswarm

# Set to 'true' only if MinIO is served over HTTPS with a valid certificate.
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# Stripe (Optional — Billing & Credits)
# ----------------------------------------------------------------------------
# Required only if you plan to use the credit-based billing system.
# Use test keys during development; never commit live keys.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------------------------
# Worker Client Settings
# ----------------------------------------------------------------------------
# Default worker name (used during auto-registration).
WORKER_NAME=default-worker

# URL of the orchestrator API.
# Use 'http://api:8000' inside Docker; use 'http://localhost:8000' natively.
ORCHESTRATOR_URL=http://api:8000
