# HuggingFace (required for auto-publish)
HF_TOKEN=hf_xxx_your_write_token_here
HF_REPO_ID=yourusername/q-mol-dataset
HF_PRIVATE=true

# PubChem ingestion
PUBCHEM_START_CID=1
PUBCHEM_BATCH_SIZE=50
MAX_HEAVY_ATOMS=8

# Compute
BASIS_SET=sto-3g
USE_VQE_UP_TO_QUBITS=12
MAX_CPU_SECONDS_PER_MOL=120

# Publishing cadence
PUBLISH_EVERY_N_MOLECULES=100
SNAPSHOT_EVERY_HOURS=6

# Kaggle auto-publish (optional)
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_SLUG=qmol-molecular-descriptors

# Gumroad auto-upload (optional)
# Create product first, then put its ID + an access token here.
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_ID=

# Database (PostgreSQL for production, SQLite for dev)
USE_POSTGRES=false
DATABASE_URL=postgresql+asyncpg://qmol:qmol@localhost:5432/qmol
REDIS_URL=redis://localhost:6379/0

# Celery (uses REDIS_URL by default; override if you use a separate Redis DB)
CELERY_BROKER_URL=${REDIS_URL}
CELERY_RESULT_BACKEND=${REDIS_URL}

# Stripe (optional — only needed for checkout webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_RESEARCH=price_research
STRIPE_PRICE_COMMERCIAL=price_commercial
STRIPE_PRICE_REDISTRIBUTION=price_redistribution

# Mailgun (optional — for auto-delivery emails)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM="Q-Mol <hi@yourdomain.com>"

# Admin token (required for admin endpoints)
QMOL_ADMIN_TOKEN=change-me-in-production

# Delivery base URL for dataset downloads
DELIVERY_BASE_URL=https://huggingface.co/datasets/YOUR/qmol/resolve/main
