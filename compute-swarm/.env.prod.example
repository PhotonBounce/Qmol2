# ============================================================================
# ComputeSwarm — Production Environment Variables (.env.prod.example)
# ============================================================================
# Copy this file to .env.prod, fill in your real values, then run:
#   cp .env.prod.example .env.prod
#   ./scripts/generate-secrets.py   # to generate strong passwords
#
# NEVER commit .env.prod to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# App Environment
# ----------------------------------------------------------------------------
APP_ENV=production

# Secret key used for JWT signing, session tokens, and other crypto.
# Generate a strong random string (64+ characters).
SECRET_KEY=generate-a-random-64-char-string-here

# JWT access token expiration time (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ----------------------------------------------------------------------------
# Domain & SSL (Traefik)
# ----------------------------------------------------------------------------
# DNS A records must point these subdomains to your VPS public IP.
API_DOMAIN=api.yourdomain.com
APP_DOMAIN=app.yourdomain.com
LETSENCRYPT_EMAIL=admin@example.com

# ----------------------------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------------------------
# Use the Docker service name 'db' as the host.
DB_USER=computeswarm
DB_PASSWORD=STRONG_DB_PASSWORD_HERE
DATABASE_URL=postgresql+asyncpg://computeswarm:STRONG_DB_PASSWORD_HERE@db:5432/computeswarm

# ----------------------------------------------------------------------------
# Redis (Cache, Queue, Pub/Sub)
# ----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------------------------
# MinIO (S3-compatible Object Storage)
# ----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=STRONG_MINIO_USER
MINIO_ROOT_PASSWORD=STRONG_MINIO_PASSWORD

# Legacy boto3 credentials (should match MinIO root credentials)
MINIO_ACCESS_KEY=STRONG_MINIO_USER
MINIO_SECRET_KEY=STRONG_MINIO_PASSWORD

MINIO_BUCKET=computeswarm
MINIO_USE_SSL=false

# ----------------------------------------------------------------------------
# Stripe (Billing & Credits)
# ----------------------------------------------------------------------------
# Use live keys in production. Test keys for staging only.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ----------------------------------------------------------------------------
# Worker / Orchestrator
# ----------------------------------------------------------------------------
# URL workers use to reach the API. Must match the public API domain.
ORCHESTRATOR_URL=https://api.yourdomain.com

# ----------------------------------------------------------------------------
# Monitoring & Alerts
# ----------------------------------------------------------------------------
# UptimeRobot / Pingdom health check URL
HEALTH_CHECK_URL=https://api.yourdomain.com/health

# ----------------------------------------------------------------------------
# Backup (optional)
# ----------------------------------------------------------------------------
BACKUP_DIR=/opt/computeswarm/backups
RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# CORS (Production)
# ----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Do NOT use "*" in production.
CORS_ORIGINS=https://app.yourdomain.com
